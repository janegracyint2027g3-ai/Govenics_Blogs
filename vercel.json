{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/repurpose/?$",
      "dest": "/repurpose/index.html"
    },
    {
      "src": "^/resources/ebooks/?$",
      "dest": "/resources/ebooks/index.html"
    },
    {
      "src": "^/ebooks/([^/]+)/?$",
      "dest": "/ebooks/$1.html"
    }
  ]
}
